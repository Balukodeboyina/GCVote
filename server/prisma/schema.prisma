datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  presentations Presentation[]
}

model Presentation {
  id          String       @id @default(uuid())
  title       String
  description String?
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions   Question[]
  slides      Slide[]
  sessions    Session[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId])
}

model Slide {
  id             String       @id @default(uuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  orderIndex     Int
  title          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([presentationId, orderIndex])
}

model Question {
  id             String       @id @default(uuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  type           String       @default("MULTIPLE_CHOICE")
  questionText   String
  position       Int          @default(0)
  settings       String       @default("{}")
  options        Option[]
  responses      Response[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([presentationId])
  @@index([presentationId, position])
}

model Option {
  id         String     @id @default(uuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean    @default(false)
  orderIndex Int        @default(0)
  responses  Response[]
  createdAt  DateTime   @default(now())

  @@index([questionId])
}

model Session {
  id                 String       @id @default(uuid())
  presentationId     String
  presentation       Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  code               String       @unique
  status             String       @default("WAITING")
  currentSlideIndex  Int          @default(0)
  acceptingResponses Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  responses          Response[]
  qaQuestions        QAQuestion[]
}

model Response {
  id            String   @id @default(uuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId      String?
  option        Option?  @relation(fields: [optionId], references: [id], onDelete: SetNull)
  textResponse  String?
  ratingValue   Int?
  participantId String
  createdAt     DateTime @default(now())

  @@index([sessionId, questionId])
  @@index([participantId])
}

model QAQuestion {
  id            String   @id @default(uuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  questionText  String
  upvotesCount  Int      @default(0)
  isAnswered    Boolean  @default(false)
  isPinned      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([sessionId])
}
